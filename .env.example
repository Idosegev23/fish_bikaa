# ===========================================
# Supabase (required)
# ===========================================
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===========================================
# Admin credentials (required)
# ===========================================
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=your_secure_password_here

# ===========================================
# Admin contact (required)
# ===========================================
VITE_ADMIN_PHONE=972501234567
VITE_ADMIN_EMAIL=admin@example.com

# ===========================================
# GreenAPI - WhatsApp messaging (required for notifications)
# Get values from: https://console.green-api.com/
# ===========================================
# Client-side (VITE_ prefix)
VITE_GREENAPI_INSTANCE_ID=your_instance_id
VITE_GREENAPI_TOKEN=your_api_token
# Server-side (Vercel API functions)
GREENAPI_INSTANCE_ID=your_instance_id
GREENAPI_TOKEN=your_api_token

# ===========================================
# Gmail SMTP (required for email confirmations)
# Requires App Password: https://myaccount.google.com/apppasswords
# ===========================================
VITE_EMAIL_USER=your_gmail@gmail.com
VITE_EMAIL_PASS=your_16_digit_app_password

# ===========================================
# CORS (set in Vercel env vars, server-side only)
# ===========================================
# CORS_ORIGIN=https://dagibkat.co.il

# ===========================================
# Printer (optional)
# ===========================================
# PRINTER_TYPE=ESCPOS
# PRINTER_IP=192.168.1.100
